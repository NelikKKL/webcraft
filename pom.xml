<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.minecraft.web</groupId>
  <artifactId>alpha126-web</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      Держим версию TeaVM в одном месте. Обновляйте вместе с teavm-maven-plugin
      ниже. 0.10.x — актуальная линейка на момент написания; CI подскажет,
      если версия протухла (артефакт не найдётся в Maven Central).
    -->
    <teavm.version>0.10.2</teavm.version>
  </properties>

  <dependencies>
    <!-- Классы-заглушки для JDK API, которые TeaVM не реализует нативно,
         но которые нужны для компиляции (javax.sound.*, java.awt частично).
         TeaVM сам подставляет свои версии java.* классов при компиляции;
         эта зависимость даёт JSBody-аннотации и служебные типы. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-interop</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>alpha126-web</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>

          <!-- ── JS-билд (основной, текущий) ─────────────────────────── -->
          <execution>
            <id>web-client-js</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <phase>process-classes</phase>
            <configuration>
              <mainClass>net.minecraft.client.WebEntryPoint</mainClass>
              <targetDirectory>${project.build.directory}/generated/js</targetDirectory>
              <targetFileName>alpha126.js</targetFileName>
              <sourceMapsGenerated>true</sourceMapsGenerated>
              <debugInformationGenerated>true</debugInformationGenerated>
              <!--
                DEBUG на первых сборках, потом переключить на WHOLE_PROGRAM
                для минификации/оптимизации, когда всё стабильно компилируется.
              -->
              <optimizationLevel>SIMPLE</optimizationLevel>
              <obfuscated>false</obfuscated>
            </configuration>
          </execution>

          <!-- ── WASM-билд ───────────────────────────────────────────────
               Генерирует alpha126.wasm + runtime-обёртку alpha126.wasm.js.
               TeaVM WASM-таргет поддерживается с 0.6.x; в 0.10.x стабилен
               для однопоточных приложений — именно наш случай (TeaVM-JS
               не поддерживает потоки, WASM-GC тоже, только обычный WASM).

               ⚠️  @JSBody / @JSFunctor НЕ РАБОТАЮТ в WASM-таргете!
               Все нативные мосты (MouseBridge, KeyboardBridge, Canvas,
               ResourcePreloader, WebEntryPoint, WebMinecraft…) написаны
               через @JSBody/@JSFunctor — они специфичны для JS-таргета.
               Реальный WASM-порт потребует замены этих мостов на
               @Import-аннотации + отдельный JS-хост-файл (см. TODO.md).
               Этот execution добавлен для будущего использования / CI-
               проверки ошибок компиляции; до замены мостов сборка
               скорее всего упадёт с "JSBody not supported in WASM target".

               Когда будет готово: targetDirectory можно объединить
               с JS-директорией или сделать отдельным dist/wasm/,
               а index.html — использовать alpha126.wasm.js вместо
               alpha126.js с тем же window.main()/Akrile-паттерном.
          -->
          <execution>
            <id>web-client-wasm</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <phase>process-classes</phase>
            <configuration>
              <mainClass>net.minecraft.client.WebEntryPoint</mainClass>
              <targetDirectory>${project.build.directory}/generated/wasm</targetDirectory>
              <targetFileName>alpha126.wasm</targetFileName>
              <!-- WASM-таргет: TeaVM генерирует бинарный .wasm + JS-обёртку -->
              <targetType>WEBASSEMBLY</targetType>
              <optimizationLevel>SIMPLE</optimizationLevel>
              <obfuscated>false</obfuscated>
              <!-- Source maps для WASM отдельные (.wasm.map) -->
              <sourceMapsGenerated>true</sourceMapsGenerated>
              <!-- Debug-info для .teavmdbg (те же инструменты отладки) -->
              <debugInformationGenerated>true</debugInformationGenerated>
            </configuration>
          </execution>

        </executions>
      </plugin>

      <!-- Копируем сгенерированный JS/WASM и статику (index.html и т.д.)
           в один выходной каталог target/site/ (артефакт / GH Pages). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-web-assets</id>
            <phase>package</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/site</outputDirectory>
              <resources>
                <!-- JS-таргет: alpha126.js + sourcemaps + .teavmdbg -->
                <resource>
                  <directory>${project.build.directory}/generated/js</directory>
                </resource>
                <!-- WASM-таргет: alpha126.wasm + alpha126.wasm.js -->
                <resource>
                  <directory>${project.build.directory}/generated/wasm</directory>
                </resource>
                <!-- Статика: index.html, akrile.js, assets.akrile и т.д. -->
                <resource>
                  <directory>${project.basedir}/web</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
